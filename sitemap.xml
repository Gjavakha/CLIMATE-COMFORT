<?xml version="1.0" encoding="UTF-8"?>
<!--
  Climate Comfort sitemap.

  The storefront is a single-page app: the catalogue, product pages and the
  legal documents are all hash routes (#catalog, #product/<id>, #terms …).
  Search engines ignore the part after "#", so those are NOT separate URLs and
  listing them here would only report URLs that resolve to this same page.

  Only the homepage is listed, which is accurate today. To get product pages
  indexed individually, the app has to serve them on real paths
  (/product/<slug>) via the History API plus a host rewrite to index.html, or
  be pre-rendered at build time — then add those URLs here.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
    <url>
        <loc>https://climatecomfort.ge/</loc>
        <lastmod>2026-09-30</lastmod>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
        <xhtml:link rel="alternate" hreflang="ka" href="https://climatecomfort.ge/"/>
        <xhtml:link rel="alternate" hreflang="en" href="https://climatecomfort.ge/?lang=en"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="https://climatecomfort.ge/"/>
    </url>
</urlset>
